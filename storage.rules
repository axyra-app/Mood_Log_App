rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Permitir acceso de lectura y escritura únicamente al propietario de la carpeta de usuario
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Denegar cualquier otro acceso por defecto
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
