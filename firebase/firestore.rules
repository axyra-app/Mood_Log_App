rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para verificar si el usuario es el propietario
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function hasStandardUserRole() {
      return request.resource.data.role == 'user';
    }

    // ========================================
    // PERFIL DE USUARIO
    // ========================================
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && hasStandardUserRole();
      allow update: if isOwner(userId) && hasStandardUserRole();
      allow delete: if isOwner(userId);
    }
    
    // ========================================
    // REGISTROS DE ESTADO DE ÁNIMO (MOOD LOGS)
    // ========================================
    match /moodLogs/{moodLogId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
    }
    
    // ========================================
    // ENTRADAS DEL DIARIO PERSONAL
    // ========================================
    match /journalEntries/{entryId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
    }
    
    // ========================================
    // NOTIFICACIONES
    // ========================================
    match /notifications/{notificationId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }
    
    // ========================================
    // CONFIGURACIÓN DE USUARIO
    // ========================================
    match /userSettings/{settingsId} {
      allow read, write: if isOwner(settingsId);
    }
    
    // ========================================
    // REPORTES AVANZADOS Y ESTADÍSTICAS
    // ========================================
    match /advancedReports/{reportId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }

    match /statistics/{statId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }
    
    // ========================================
    // RECORDATORIOS
    // ========================================
    match /reminders/{reminderId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }
    
    // ========================================
    // PLANTILLAS Y PROMPTS DEL DIARIO (LECTURA PÚBLICA AUTENTICADA)
    // ========================================
    match /journalTemplates/{templateId} {
      allow read: if request.auth != null;
    }
    
    match /journalPrompts/{promptId} {
      allow read: if request.auth != null;
    }

    // Regla por defecto: Denegar cualquier otra colección no especificada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}